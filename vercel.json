{
  "buildCommand": "npm install",
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_KEY": "@supabase_key"
  },
  "redirects": [
    {
      "source": "/intake",
      "destination": "/intake.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html",
      "permanent": false
    }
  ]
}
